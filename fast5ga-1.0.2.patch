+#[cfg(test)]
+mod connection_tests {
+    use super::*;
+
+    #[test]
+    fn changing_service_port_invalidates_old_rsd_route() {
+        let route = CachedRoute {
+            host: "10.7.0.1".into(),
+            port: 52107,
+            mode: CachedRouteMode::RsdRemoteXpc,
+        };
+        assert!(route.accepts_port(52107));
+        assert!(!route.accepts_port(49152));
+        let legacy = CachedRoute { port: 62078, mode: CachedRouteMode::Lockdown, ..route };
+        assert!(legacy.accepts_port(52107));
+    }
+
+    #[test]
+    fn primary_refusal_is_not_hidden_by_fallback_timeouts() {
+        let mut primary = String::new();
+        remember_first_error(&mut primary, "10.7.0.1:52107: Connection refused (os error 61)".into());
+        remember_first_error(&mut primary, "10.7.0.2:52107: timeout".into());
+        remember_first_error(&mut primary, "172.16.0.1:52107: timeout".into());
+        let error = connection_failure_message(&primary, 52107);
+        assert!(error.contains("10.7.0.1:52107: Connection refused"));
+        assert!(!error.contains("172.16.0.1"));
+        assert!(!error.contains("Ensure a loopback VPN"));
+    }
+
+    #[test]
+    fn selecting_a_dynamic_port_reaches_native_configuration() {
+        set_target_port(52107);
+        assert_eq!(target_port(), 52107);
+        clear_target_hosts();
+        assert_eq!(target_port(), DEFAULT_RSD_PORT);
+    }
+}
