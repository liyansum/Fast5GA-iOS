+const DEFAULT_RSD_PORT: u16 = 49152;
+static TARGET_RSD_PORT: std::sync::atomic::AtomicU16 = std::sync::atomic::AtomicU16::new(DEFAULT_RSD_PORT);
+
+pub fn set_target_port(port: u16) {
+    TARGET_RSD_PORT.store(port, std::sync::atomic::Ordering::Relaxed);
+}
+
+fn target_port() -> u16 {
+    TARGET_RSD_PORT.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+fn remember_first_error(primary: &mut String, error: String) {
+    if primary.is_empty() { *primary = error; }
+}
+
+fn connection_failure_message(primary: &str, port: u16) -> String {
+    format!("连接失败：{primary}。本次 Remote Pairing 端口为 {port}。连接被拒绝表示该地址和端口未接受连接，不能据此判定 VPN 未开启或配对失效。若其他工具正常，请核对其当前 Remote Pairing 端口，并在配对页手动填写后重试。")
